 # -*- mode: snippet -*-
# name: custom module
# key: module
# --



{ ... }:
{
  flake.nixosModules.logitechs =
    { config, lib, ... }:
    let
      cfg = config.my.services.${1:module-name};
    in
    {
      options.my.services.$1.enable =
        lib.mkEnableOption "${2:module-description}";

      config = lib.mkIf cfg.enable {
      $3
      };
    };
}



